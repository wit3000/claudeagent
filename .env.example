# Required — get free key at https://console.groq.com/keys  (no card required)
GROQ_API_KEY=gsk_...

# Model (free tier: llama-3.3-70b-versatile — 30 RPM, 12k TPM)
MODEL_ID=llama-3.3-70b-versatile

# Auth mode: pick ONE
PUBLIC_MODE=1
# APP_PASSWORD=change-me

# Abuse protection
RATE_LIMIT_PER_HOUR=20
MAX_TEXT_CHARS=20000

# Persistence
DB_PATH=data/reviewer.db
