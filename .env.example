# Required — get free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Model (free tier: gemini-2.5-flash — 10 RPM, 250k TPM, 500 RPD)
MODEL_ID=gemini-2.5-flash

# Auth mode: pick ONE
#   PUBLIC_MODE=1  -> anyone with the URL can use it (protected only by rate limit)
#   APP_PASSWORD=... -> HTTP Basic, any username, this password
PUBLIC_MODE=1
# APP_PASSWORD=change-me

# Abuse protection
RATE_LIMIT_PER_HOUR=20
MAX_TEXT_CHARS=20000

# Persistence
DB_PATH=data/reviewer.db
