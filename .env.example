# --- LLM provider selection ---
# Which provider to use: groq | openai | anthropic | gemini | openrouter
LLM_PROVIDER=groq

# API key for the chosen provider (only the one you use needs to be set):
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# Model override (optional; each provider has a sensible default):
# MODEL_ID=llama-3.3-70b-versatile

# Optional automatic failover: comma-separated provider:model list.
# If the first provider fails, the next one is used and a note appears in the report.
# LLM_FALLBACK_CHAIN=groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free

# --- Limits ---
MAX_TEXT_CHARS=20000
PROCESS_MAX_PER_HOUR=30

# --- Persistence (history) ---
# On HF free tier use /tmp (ephemeral); on a real disk use a persistent path.
DB_PATH=data/reviewer.db

# --- Deploy (scripts/deploy_hf.py) ---
# HF_TOKEN=hf_...
