# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model
MODEL_ID=claude-sonnet-5

# Auth mode: pick ONE
#   PUBLIC_MODE=1  -> anyone with the URL can use it (protected only by rate limit)
#   APP_PASSWORD=... -> HTTP Basic, any username, this password
PUBLIC_MODE=1
# APP_PASSWORD=change-me

# Abuse protection (only enforced on POST /api/review)
RATE_LIMIT_PER_HOUR=20
MAX_TEXT_CHARS=20000

# Persistence
DB_PATH=data/reviewer.db
